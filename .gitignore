.DS_Store
Thumbs.db

# agent 工作目录，不进知识库版本历史
.workbuddy/

# 观察者/编辑器本地状态
.obsidian/workspace*.json
.obsidian/cache
.vscode/
.idea/

# 大文件不入版本库（文件本身保留在磁盘上）
raw/files/**/*.zip
raw/files/**/*.mp4
raw/files/**/*.dmg
raw/files/**/*.pcap

# 站点构建缓存（site/ 下的产物 index.html / content.json / kb.json 需要入库）
site/__pycache__/
site/tests/__pycache__/
site/tests/.pytest_cache/
site/tests/.tmp/
site/tests/.tmp_archive/
*.pyc

# 临时文件
*.tmp
*.swp
*~

# 前端调试插桩副本（用完即删，禁止入库）
site/_diag.html
site/_shot.html
